{
  "name": "loofah",
  "version": "0.38.0",
  "private": true,
  "scripts": {
    "cloudflare:login": "pnpm -F @hypr/docs exec wrangler login --scopes account:read user:read workers:write workers_routes:write workers_scripts:write workers_tail:read d1:write zone:read queues:write email_sending:write challenge-widgets.write",
    "cloudflare:whoami": "pnpm -F @hypr/docs exec wrangler whoami",
    "fmt:check": "dprint check",
    "fmt": "dprint fmt",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint",
    "lint:oxlint": "oxlint --type-aware",
    "plugin:hello-world:install": "pnpm --dir examples/plugins/hello-world install:dev"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.61.0",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "dprint": "^0.51.1",
    "eslint": "^9.39.4",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.1",
    "turbo": "2.9.14",
    "typescript-eslint": "^8.58.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "dprint fmt"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  }
}
