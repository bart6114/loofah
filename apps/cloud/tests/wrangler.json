    "bindings": [
      {
        "name": "PAIRING",
        "class_name": "PairingMailbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pairing-v1",
      "new_sqlite_classes": [
        "PairingMailbox"
      ]
    }
  ]
}
