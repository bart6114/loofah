{
  "name": "loofah-sync-runtime-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test",
      "database_id": "11111111-1111-4111-8111-111111111111"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT",
      "bucket_name": "test"
    }
  ],
