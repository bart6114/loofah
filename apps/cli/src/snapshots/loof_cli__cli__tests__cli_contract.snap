---
source: apps/cli/src/cli.rs
expression: canonicalize_json(contract)
---
{
  "about": "Query and edit local Loofah meeting data",
  "global_options": [
    {
      "flags": "--base",
      "is_flag": false,
      "required": false,
      "value_name": "DIR"
    },
    {
      "flags": "--vault-path",
      "is_flag": false,
      "required": false,
      "value_name": "DIR"
    },
    {
      "flags": "--json",
      "is_flag": true,
      "required": false
    }
  ],
  "name": "loof",
  "options": [
    {
      "flags": "-h, --help",
      "help": "Print help",
      "is_flag": false,
      "required": false
    },
    {
      "flags": "-V, --version",
      "help": "Print version",
      "is_flag": false,
      "required": false
    }
  ],
  "subcommands": [
    {
      "about": "Check vault access and layout; refresh the vault guide. Open desktop to migrate",
      "name": "loof doctor",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "loof doctor [-h]"
    },
    {
      "about": "Browse, create, edit, and export sessions",
      "name": "loof sessions",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "subcommands": [
        {
          "about": "List meetings, optionally filtered by text or tags",
          "name": "loof sessions list",
          "options": [
            {
              "flags": "-q, --query",
              "is_flag": false,
              "required": false,
              "value_name": "QUERY"
            },
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum results (1-200)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of results to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "--tag",
              "help": "Only meetings carrying this tag; repeatable, all must match",
              "is_flag": false,
              "required": false,
              "value_name": "NAME"
            },
            {
              "flags": "--untagged",
              "help": "Only meetings without any tags",
              "is_flag": true,
              "required": false
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions list [-q] [--limit] [--offset] [--tag] [--untagged] [-h]"
        },
        {
          "about": "Search across meeting titles, notes, summaries, and transcripts",
          "arguments": [
            {
              "help": "Case-insensitive terms that must all occur",
              "name": "QUERY",
              "required": false
            }
          ],
          "name": "loof sessions search",
          "options": [
            {
              "flags": "--speaker",
              "help": "Person id or name substring; limits hits to meetings where that person spoke",
              "is_flag": false,
              "required": false,
              "value_name": "SPEAKER"
            },
            {
              "flags": "--kind",
              "help": "Restrict to a source; repeatable, defaults to all",
              "is_flag": false,
              "possible_values": [
                "title",
                "note",
                "summary",
                "transcript"
              ],
              "required": false,
              "value_name": "KIND"
            },
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum hits (1-50)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of hits to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions search [--speaker] [--kind] [--limit] [--offset] [-h] [query]"
        },
        {
          "about": "Show meeting metadata, notes, summaries, and action items",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions get",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions get [-h] <id>"
        },
        {
          "about": "Create a meeting note and print its id",
          "name": "loof sessions new",
          "options": [
            {
              "flags": "--title",
              "help": "Title for the new meeting",
              "is_flag": false,
              "required": true,
              "value_name": "TITLE"
            },
            {
              "flags": "--note",
              "help": "Initial note body read from FILE, or '-' for stdin",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "--created-at",
              "help": "Creation timestamp for the meeting (RFC 3339), e.g. 2024-05-01T09:00:00Z; defaults to now",
              "is_flag": false,
              "required": false,
              "value_name": "RFC3339"
            },
            {
              "flags": "--started-at",
              "help": "Start timestamp for the meeting (RFC 3339)",
              "is_flag": false,
              "required": false,
              "value_name": "RFC3339"
            },
            {
              "flags": "--ended-at",
              "help": "End timestamp for the meeting (RFC 3339)",
              "is_flag": false,
              "required": false,
              "value_name": "RFC3339"
            },
            {
              "flags": "--tag",
              "help": "Tag for the new meeting; repeatable",
              "is_flag": false,
              "required": false,
              "value_name": "NAME"
            },
            {
              "flags": "--author",
              "help": "Record who wrote this meeting's note; set this when writing on behalf of someone other than the vault owner (e.g. claude-code)",
              "is_flag": false,
              "required": false,
              "value_name": "NAME"
            },
            {
              "flags": "--skill",
              "help": "Record the skill used to produce this meeting's note (e.g. meeting-summarizer); only meaningful together with --author",
              "is_flag": false,
              "required": false,
              "value_name": "NAME"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions new <--title> [--note] [--created-at] [--started-at] [--ended-at] [--tag] [--author] [--skill] [-h]"
        },
        {
          "about": "Show the note or generated summaries for a meeting, or edit the note",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions note",
          "options": [
            {
              "default": "note",
              "flags": "--kind",
              "is_flag": false,
              "possible_values": [
                "note",
                "summary",
                "all"
              ],
              "required": false,
              "value_name": "KIND"
            },
            {
              "flags": "--set",
              "help": "Replace the note body with FILE, or '-' for stdin",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "--append",
              "help": "Append FILE (or '-' for stdin) to the note body",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions note [--kind] [--set] [--append] [-h] <id>"
        },
        {
          "about": "Show the full speaker-labeled meeting transcript",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions transcript",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions transcript [-h] <id>"
        },
        {
          "about": "Add or remove tags on a meeting",
          "name": "loof sessions tag",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "subcommands": [
            {
              "about": "Add tags to a meeting, registering new ones in the vault's tag registry",
              "arguments": [
                {
                  "name": "ID",
                  "required": true
                },
                {
                  "name": "TAG",
                  "required": true
                }
              ],
              "name": "loof sessions tag add",
              "options": [
                {
                  "flags": "-h, --help",
                  "help": "Print help",
                  "is_flag": false,
                  "required": false
                }
              ],
              "synopsis": "loof sessions tag add [-h] <id> <tags>"
            },
            {
              "about": "Remove tags from a meeting; the tag registry keeps the names",
              "arguments": [
                {
                  "name": "ID",
                  "required": true
                },
                {
                  "name": "TAG",
                  "required": true
                }
              ],
              "name": "loof sessions tag remove",
              "options": [
                {
                  "flags": "-h, --help",
                  "help": "Print help",
                  "is_flag": false,
                  "required": false
                }
              ],
              "synopsis": "loof sessions tag remove [-h] <id> <tags>"
            }
          ],
          "synopsis": "loof sessions tag [-h] <command>"
        },
        {
          "about": "Print the absolute path of a meeting's session directory",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions path",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions path [-h] <id>"
        },
        {
          "about": "Move the complete session directory to recoverable vault trash. The exact ID is the confirmation: no prompt or confirmation flag, including with --json. Missing or already-deleted IDs fail with not_found (exit 2). No permanent purge.",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions delete",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help (see a summary with '-h')",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions delete [-h] <id>"
        },
        {
          "about": "Store a file as a note attachment of a meeting and print its attachment id",
          "arguments": [
            {
              "help": "File to store under the meeting's attachments directory",
              "name": "FILE",
              "required": true
            },
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions attach",
          "options": [
            {
              "flags": "--name",
              "help": "Filename to store the attachment under; defaults to the file's name",
              "is_flag": false,
              "required": false,
              "value_name": "NAME"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions attach [--name] [-h] <file> <id>"
        },
        {
          "about": "Export a meeting to Markdown or JSON",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "loof sessions export",
          "options": [
            {
              "default": "markdown",
              "flags": "--format",
              "is_flag": false,
              "possible_values": [
                "markdown",
                "json"
              ],
              "required": false,
              "value_name": "FORMAT"
            },
            {
              "flags": "-o, --output",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "--force",
              "help": "Replace an existing output file",
              "is_flag": true,
              "required": false
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof sessions export [--format] [-o] [--force] [-h] <id>"
        }
      ],
      "synopsis": "loof sessions [-h] <command>"
    },
    {
      "about": "Import an audio file into a new or existing meeting and print its id",
      "arguments": [
        {
          "help": "Audio file to import (wav, mp3, ogg, mp4, m4a, flac, webm, or aac)",
          "name": "FILE",
          "required": true
        }
      ],
      "name": "loof import",
      "options": [
        {
          "flags": "--title",
          "help": "Title for the new meeting; defaults to the file name",
          "is_flag": false,
          "required": false,
          "value_name": "TITLE"
        },
        {
          "flags": "--into",
          "help": "Import into this existing meeting instead of creating a new one; fails if it already has a recording",
          "is_flag": false,
          "required": false,
          "value_name": "MEETING_ID"
        },
        {
          "flags": "--transcribe",
          "help": "Transcribe the audio with the configured on-device model after importing",
          "is_flag": true,
          "required": false
        },
        {
          "flags": "--created-at",
          "help": "Creation timestamp for the new meeting (RFC 3339); defaults to now",
          "is_flag": false,
          "required": false,
          "value_name": "RFC3339"
        },
        {
          "flags": "--started-at",
          "help": "Start timestamp for the new meeting (RFC 3339)",
          "is_flag": false,
          "required": false,
          "value_name": "RFC3339"
        },
        {
          "flags": "--ended-at",
          "help": "End timestamp for the new meeting (RFC 3339)",
          "is_flag": false,
          "required": false,
          "value_name": "RFC3339"
        },
        {
          "flags": "--author",
          "help": "Record who wrote the new meeting's note; set this when writing on behalf of someone other than the vault owner (e.g. claude-code)",
          "is_flag": false,
          "required": false,
          "value_name": "NAME"
        },
        {
          "flags": "--skill",
          "help": "Record the skill used to produce the new meeting's note (e.g. meeting-summarizer); only meaningful together with --author",
          "is_flag": false,
          "required": false,
          "value_name": "NAME"
        },
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "loof import [--title] [--into] [--transcribe] [--created-at] [--started-at] [--ended-at] [--author] [--skill] [-h] <file>"
    },
    {
      "about": "Transcribe a meeting's audio with the configured on-device model",
      "arguments": [
        {
          "help": "Meeting id whose audio should be transcribed",
          "name": "ID",
          "required": true
        }
      ],
      "name": "loof transcribe",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "loof transcribe [-h] <id>"
    },
    {
      "about": "Run the read-only Loofah MCP server over stdio",
      "name": "loof mcp",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "loof mcp [-h]"
    },
    {
      "about": "Browse the vault's tag registry",
      "name": "loof tags",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "subcommands": [
        {
          "about": "List every tag registered in the vault",
          "name": "loof tags list",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "loof tags list [-h]"
        }
      ],
      "synopsis": "loof tags [-h] <command>"
    }
  ],
  "synopsis": "loof [--base] [--vault-path] [--json] [-h] [-V] <command>"
}
