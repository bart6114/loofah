---
source: apps/cli/src/mcp.rs
expression: "canonicalize_json(serde_json::json!({\n    \"protocol_version\": info.protocol_version, \"instructions\":\n    info.instructions, \"tools\": tools, \"resource_templates\": templates,\n}))"
---
{
  "instructions": "Read-only, local access to Loofah meeting data. Start with list_meetings to resolve a meeting_id, then call get_meeting for notes, summaries, and action items. Call get_meeting_transcript for the full transcript as speaker-labeled '[HH:MM:SS] Speaker: ...' lines. Use search_meetings for keyword search across titles, notes, summaries, and transcript words, optionally limited to meetings where a specific speaker spoke; transcript hits include a start_ms that lines up with the transcript's timestamps. Never invent meeting ids, access SQLite directly, or claim a write occurred: every tool is idempotent and performs no writes. Documentation: https://github.com/bart6114/loofah",
  "protocol_version": "2024-11-05",
  "resource_templates": [
    {
      "description": "Meeting metadata, note, summaries, and action items",
      "mimeType": "text/markdown",
      "name": "Loofah meeting",
      "uriTemplate": "loofah://meetings/{meeting_id}"
    },
    {
      "description": "The full speaker-labeled meeting transcript",
      "mimeType": "text/plain",
      "name": "Loofah meeting transcript",
      "uriTemplate": "loofah://meetings/{meeting_id}/transcript"
    }
  ],
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get one Loofah meeting with its canonical note, summaries, and action items. Use get_meeting_transcript separately for transcript words.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "meeting_id": {
            "description": "Loofah meeting id",
            "type": "string"
          }
        },
        "required": [
          "meeting_id"
        ],
        "title": "GetMeetingInput",
        "type": "object"
      },
      "name": "get_meeting"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get the full transcript of a Loofah meeting as readable text: one '[HH:MM:SS] Speaker: ...' line per speaker turn, timed from the start of the meeting.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "meeting_id": {
            "description": "Loofah meeting id",
            "type": "string"
          }
        },
        "required": [
          "meeting_id"
        ],
        "title": "GetMeetingTranscriptInput",
        "type": "object"
      },
      "name": "get_meeting_transcript"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List recent Loofah meetings with pagination metadata. Use query to narrow by title or meeting id, then pass next_offset as offset to continue.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "description": "Maximum results; defaults to 20 and is capped at 200",
            "format": "uint32",
            "maximum": 200,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Number of results to skip; defaults to 0",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "query": {
            "description": "Case-insensitive title or meeting id substring",
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "description": "Only meetings carrying every one of these tags (case-insensitive)",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "untagged": {
            "description": "Only meetings without any tags; cannot be combined with tags",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "ListMeetingsInput",
        "type": "object"
      },
      "name": "list_meetings"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Full-text search across Loofah meeting titles, notes, summaries, and transcript words. Set speaker to limit results to meetings where that person spoke, with the query matching anywhere in those transcripts (without query it lists those meetings); transcript hits carry a start_ms that matches the transcript's [HH:MM:SS] timestamps.",
      "inputSchema": {
        "$defs": {
          "SearchKind": {
            "enum": [
              "title",
              "note",
              "summary",
              "transcript"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "kinds": {
            "description": "Sources to search (title, note, summary, transcript); defaults to all. Ignored when speaker is set: speaker search is transcript-only",
            "items": {
              "$ref": "#/$defs/SearchKind"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "limit": {
            "description": "Maximum hits; defaults to 20 and is capped at 50",
            "format": "uint32",
            "maximum": 50,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Number of hits to skip; defaults to 0",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "query": {
            "description": "Search words and quoted phrases, with a trailing word prefix; results are ranked by relevance, once per session. Required unless speaker is set",
            "type": [
              "string",
              "null"
            ]
          },
          "speaker": {
            "description": "Case-insensitive person id or name substring; limits results to meetings where that person spoke. The query matches anywhere in those transcripts; without query, lists meetings where they spoke",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "SearchMeetingsInput",
        "type": "object"
      },
      "name": "search_meetings"
    }
  ]
}
