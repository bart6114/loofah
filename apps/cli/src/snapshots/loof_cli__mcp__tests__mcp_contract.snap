---
source: apps/cli/src/mcp.rs
expression: "canonicalize_json(serde_json::json!({\n    \"protocol_version\": info.protocol_version, \"instructions\":\n    info.instructions, \"tools\": tools, \"resource_templates\": templates,\n}))"
---
{
  "instructions": "Read-only, local access to Loofah meeting data. Start with list_meetings to resolve a meeting_id, then call get_meeting for notes, summaries, and action items. Call get_meeting_transcript for the full transcript as speaker-labeled '[HH:MM:SS] Speaker: ...' lines. Use search_meetings for keyword search across titles, notes, summaries, and transcript words, using desktop relevance ranking and one result per session. Never invent meeting ids, access SQLite directly, or claim a write occurred: tools never change vault content; search and list requests refresh the local search cache. Documentation: https://github.com/bart6114/loofah",
  "protocol_version": "2024-11-05",
  "resource_templates": [
    {
      "description": "Meeting metadata, note, summaries, and action items",
      "mimeType": "text/markdown",
      "name": "Loofah meeting",
      "uriTemplate": "loofah://meetings/{meeting_id}"
    },
    {
      "description": "The full speaker-labeled meeting transcript",
      "mimeType": "text/plain",
      "name": "Loofah meeting transcript",
      "uriTemplate": "loofah://meetings/{meeting_id}/transcript"
    }
  ],
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get one Loofah meeting with its canonical note, summaries, and action items. Use get_meeting_transcript separately for transcript words.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "meeting_id": {
            "description": "Loofah meeting id",
            "type": "string"
          }
        },
        "required": [
          "meeting_id"
        ],
        "title": "GetMeetingInput",
        "type": "object"
      },
      "name": "get_meeting"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get the full transcript of a Loofah meeting as readable text: one '[HH:MM:SS] Speaker: ...' line per speaker turn, timed from the start of the meeting.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "meeting_id": {
            "description": "Loofah meeting id",
            "type": "string"
          }
        },
        "required": [
          "meeting_id"
        ],
        "title": "GetMeetingTranscriptInput",
        "type": "object"
      },
      "name": "get_meeting_transcript"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List recent Loofah meetings with pagination metadata. Use query for relevance-ranked full-text matches, then pass next_offset as offset to continue.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "description": "Maximum results; defaults to 20 and is capped at 200",
            "format": "uint32",
            "maximum": 200,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Number of results to skip; defaults to 0",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "query": {
            "description": "Desktop-compatible full-text query across titles and content",
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "description": "Only meetings carrying every one of these tags (case-insensitive)",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "untagged": {
            "description": "Only meetings without any tags; cannot be combined with tags",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "title": "ListMeetingsInput",
        "type": "object"
      },
      "name": "list_meetings"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Desktop-compatible full-text search across session titles and content. Returns one relevance-ranked result per session with its ID, score, and snippets; fetch the full transcript separately when needed.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "Maximum session hits; defaults to 20 and is capped at 50",
            "format": "uint32",
            "maximum": 50,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Number of session hits to skip; defaults to 0",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "query": {
            "description": "Desktop-compatible full-text query: words, quoted phrases, and a trailing word prefix",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchMeetingsInput",
        "type": "object"
      },
      "name": "search_meetings"
    }
  ]
}
