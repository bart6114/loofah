{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loofah Dev",
  "mainBinaryName": "loofah-dev",
  "identifier": "io.loofah.dev",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "pnpm -F desktop dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm -F desktop build",
    "beforeBundleCommand": "node ./src-tauri/scripts/before-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "publisher": "Bart Smeets",
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.icns",
      "icons/stable/icon.ico"
    ],
    "resources": {
      "icons/stable/icon.icns": "icons/stable.icns",
      "resources/stable-dark/AppIcon.icns": "icons/stable-dark.icns",
      "resources/notification-icons": "notification-icons",
      "resources/codex/models.json": "codex/models.json",
      "resources/codex/LICENSE": "codex/LICENSE",
      "resources/codex/NOTICE": "codex/NOTICE"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "assets/dmg-background-stable.png",
        "windowSize": {
          "width": 660,
          "height": 430
        },
        "appPosition": {
          "x": 177,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 483,
          "y": 200
        }
      },
      "files": {
        "Resources/mlx-swift_Cmlx.bundle/default.metallib": "resources/mlx.metallib",
        "Resources/AppIcon.incs": "resources/stable/AppIcon.icns",
        "Resources/Assets.car": "resources/stable/Assets.car"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "loofah",
          "freemeetingtranscriber"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRDgzOUQ5OTFCNkI2MUIKUldRYnRyYVIyVG5ZNzlxVXVCank4MEozbFVCdG9ManFuYWpJdW1Nc0V3YnhlM1R5UmFFa3F0ZGUK"
    }
  }
}
