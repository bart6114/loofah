{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loofah",
  "mainBinaryName": "loofah",
  "identifier": "io.loofah.stable",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "loofah",
          "freemeetingtranscriber"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/bart6114/loofah/releases/download/updater/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/check-permissions",
      "binaries/loof"
    ]
  }
}
